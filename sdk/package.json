    "prepare": "panda codegen && panda cssgen --outfile styled-system/styles.css",
    "tsup": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "build": "panda codegen && panda cssgen --outfile styled-system/styles.css && node scripts/generate-css-module.cjs && NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=8192} npx tsup && if [ \"${SDK_STAGING_DTS:-0}\" = \"1\" ]; then tsc -p tsconfig.staging-dts.json; fi",
    "dev": "tsup --watch",
    "test:wallet-lifecycle": "bun test src/shared/api/idempotency.test.ts src/shared/api/ws-ticket.test.ts src/shared/realtime-active-intent.test.ts src/shared/realtime-protocol.test.ts src/shared/realtime-reconnect-delay.test.ts"
